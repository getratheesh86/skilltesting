        <mxCell id="NOTE1" value="&lt;b style=&quot;font-size:11px&quot;&gt;📋 Scenario Catalog (BlackRock Standard)&lt;/b&gt;&lt;hr style=&quot;margin:5px 0&quot;&gt;&lt;ul style=&quot;margin:2px 0 0 8px;padding:0;text-align:left;font-size:8px&quot;&gt;&lt;li&gt;&lt;b&gt;Happy path:&lt;/b&gt; 200/201 + correct payload&lt;/li&gt;&lt;li&gt;&lt;b&gt;Negative:&lt;/b&gt; missing field/datatype/enum → 400&lt;/li&gt;&lt;li&gt;&lt;b&gt;Security:&lt;/b&gt; no/expired token → 401; wrong role → 403&lt;/li&gt;&lt;li&gt;&lt;b&gt;Contract:&lt;/b&gt; schema + required fields; standard error&lt;/li&gt;&lt;li&gt;&lt;b&gt;Idempotency:&lt;/b&gt; retry no duplicates; update only changed&lt;/li&gt;&lt;li&gt;&lt;b&gt;Non-functional:&lt;/b&gt; response time threshold; rate-limit 429&lt;/li&gt;&lt;/ul&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#0B1F3B;fontFamily=Segoe UI;fontSize=9;position2=0;base=15;size=15;align=left;spacingLeft=8;spacingRight=8;spacingTop=4;" vertex="1" parent="1">
