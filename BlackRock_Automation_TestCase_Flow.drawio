                <mxCell id="NOTE_N1" value="&lt;b style=&quot;font-size:12px&quot;&gt;📋 Scenario Catalog (Reusable)&lt;/b&gt;&lt;hr style=&quot;margin:6px 0&quot;&gt;&lt;ul style=&quot;margin:2px 0 0 10px;padding:0;text-align:left;font-size:9px&quot;&gt;&lt;li&gt;&lt;b&gt;Happy path:&lt;/b&gt; 200/201 + correct payload&lt;/li&gt;&lt;li&gt;&lt;b&gt;Optional fields missing:&lt;/b&gt; defaults applied&lt;/li&gt;&lt;li&gt;&lt;b&gt;Negative:&lt;/b&gt; missing mandatory → 400&lt;/li&gt;&lt;li&gt;&lt;b&gt;Negative:&lt;/b&gt; invalid datatype/enum → 400&lt;/li&gt;&lt;li&gt;&lt;b&gt;Security:&lt;/b&gt; no token/expired → 401; wrong role → 403&lt;/li&gt;&lt;li&gt;&lt;b&gt;Contract:&lt;/b&gt; schema + required fields; standard error&lt;/li&gt;&lt;li&gt;&lt;b&gt;Idempotency:&lt;/b&gt; retry no duplicates; update only changed&lt;/li&gt;&lt;li&gt;&lt;b&gt;Non-functional:&lt;/b&gt; response time threshold; rate limit 429&lt;/li&gt;&lt;/ul&gt;" style="shape=callout;whiteSpace=wrap;html=1;perimeter=calloutPerimeter;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#0B1F3B;fontFamily=Segoe UI;fontSize=10;position2=0;base=20;size=20;align=left;spacingLeft=10;spacingRight=10;spacingTop=5;" parent="1" vertex="1">
